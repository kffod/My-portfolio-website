# Copy this file to .env.local and fill in what you need. Never commit .env.local.

# --- Contact form ---
# Free: get an access key at web3forms.com (enter the email you want messages sent to).
# It's meant to be public, so the NEXT_PUBLIC_ prefix is fine. Without it, the form opens the
# visitor's email app with the message filled in.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- "Ask my portfolio" assistant (app/api/ask/route.js) ---
# Leave everything below empty and the assistant still works for free: it answers with the
# best-matching sentences from this site, with citations. No AI model, no key, no cost.
#
# To have an AI model write the answers instead, set ONE of these:

# Option A: any OpenAI-compatible API. Groq and Google Gemini both offer free tiers
# (check each provider's current limits and model list before relying on them).
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                        key: console.groq.com/keys
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  key: aistudio.google.com
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Option B: Claude (paid API key from console.anthropic.com). Used first if it's set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: questions allowed per visitor every 10 minutes (default 8)
ASK_RATE_LIMIT=8

# Optional: questions allowed per day across all visitors, per server instance (default 300)
ASK_DAILY_LIMIT=300
